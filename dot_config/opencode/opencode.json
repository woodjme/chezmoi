{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "plugins": [
    "opencode-claude-auth-v2@0.4.0-beta.6"
  ],
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ],
  "websearch": {
    "provider": "random"
  },
  "media": {
    "image": {
      "auto_resize": true
    }
  },
  "mcp": {
    "servers": {
      "todoist": {
        "type": "remote",
        "url": "https://ai.todoist.net/mcp"
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp"
      },
      "metabase-zerobased": {
        "type": "remote",
        "url": "https://metabase.zerobased.co.uk/api/metabase-mcp",
        "disabled": true
      },
      "gitlab-zerobased": {
        "type": "remote",
        "url": "https://git.zerobased.dev/api/v4/mcp"
      },
      "openflowkit": {
        "type": "local",
        "command": ["npx", "-y", "@vrun-design/openflowkit-mcp"]
      }
    }
  }
}
