{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "theme": "system",
  "plugin": [
    "opencode-claude-auth@2.2.1",
    "opencode-history-search@1.5.1",
    "envsitter-guard@latest",
    "opencode-image-resizer@latest",
    "./vendor/i-have-adhd/.opencode/plugins/i-have-adhd.mjs"
  ],
  "permission": {
    "websearch": "allow"
  },
  "mcp": {
    "todoist": {
      "type": "remote",
      "url": "https://ai.todoist.net/mcp"
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp"
    },
    "metabase": {
      "type": "remote",
      "url": "https://metabase.zerobased.co.uk/api/metabase-mcp",
      "enabled": false
    }
  }
}
