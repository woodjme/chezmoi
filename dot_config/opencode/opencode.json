{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "plugins": [
    "@ex-machina/opencode-anthropic-auth@next"
  ],
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.sample", "effect": "allow" },
    { "action": "read", "resource": "*.env.template", "effect": "allow" },
    { "action": "read", "resource": "*.env.dist", "effect": "allow" },
    { "action": "read", "resource": "*.env.default", "effect": "allow" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env.sample", "effect": "allow" },
    { "action": "edit", "resource": "*.env.template", "effect": "allow" },
    { "action": "edit", "resource": "*.env.dist", "effect": "allow" },
    { "action": "edit", "resource": "*.env.default", "effect": "allow" },
    { "action": "read", "resource": "*.envsitter/*", "effect": "deny" }
  ],
  "websearch": {
    "provider": "random"
  },
  "media": {
    "image": {
      "auto_resize": true
    }
  },
  "mcp": {
    "servers": {
      "todoist": {
        "type": "remote",
        "url": "https://ai.todoist.net/mcp"
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp"
      },
      "metabase-zerobased": {
        "type": "remote",
        "url": "https://metabase.zerobased.co.uk/api/metabase-mcp",
        "disabled": true
      },
      "gitlab-zerobased": {
        "type": "remote",
        "url": "https://git.zerobased.dev/api/v4/mcp"
      },
      "openflowkit": {
        "type": "local",
        "command": ["npx", "-y", "@vrun-design/openflowkit-mcp"]
      }
    }
  }
}
