#!/bin/bash

{{- if not .use1PasswordAWS }}
exit 0
{{- end }}

# The AWS templates read from 1Password once this script returns. Checking
# here first turns chezmoi's bare template error into steps to fix it.

YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

ACCOUNT={{ .onepasswordAccount | quote }}
DOCUMENTS=(aws-config aws-credentials)

check_access() {
    local doc
    for doc in "${DOCUMENTS[@]}"; do
        if ! op_error=$(op document get "$doc" --account "$ACCOUNT" 2>&1 >/dev/null); then
            failed_doc="$doc"
            return 1
        fi
    done
}

while ! check_access; do
    echo ""
    echo -e "${RED}Could not read the 1Password document '$failed_doc', which ~/.aws needs.${NC}"
    echo "  op said: $op_error"
    echo ""
    echo -e "${YELLOW}Before chezmoi can apply, check that:${NC}"
    echo "  1. 1Password is open, signed in and unlocked"
    echo "  2. 1Password > Settings > Developer > 'Integrate with 1Password CLI' is on"
{{- if eq .chezmoi.os "darwin" }}
    echo "  3. Your terminal is allowed to talk to 1Password. macOS asks"
    echo "     '<terminal> would like to access data from other apps' the first time;"
    echo "     allow it. If it was denied, give your terminal Full Disk Access in"
    echo "     System Settings > Privacy & Security, then restart the terminal."
    echo "  4. Documents named 'aws-config' and 'aws-credentials' exist in that account"
{{- else }}
    echo "  3. Documents named 'aws-config' and 'aws-credentials' exist in that account"
{{- end }}
    echo ""

    if [ ! -t 0 ]; then
        exit 1
    fi
    echo -n "Press Enter to retry, or Ctrl-C to stop..."
    read -r
done
